{
  "name": "gestao-armarios",
  "author": "Elton Marques",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @armarios/api",
    "dev:web": "npm run dev -w @armarios/web",
    "build": "npm run build -w @armarios/contracts && npm run build -w @armarios/api && npm run build -w @armarios/web",
    "build:portable": "node scripts/portable/build.mjs",
    "package:portable": "npm run build:portable",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "npm run migrate -w @armarios/api",
    "db:bootstrap": "npm run bootstrap -w @armarios/api",
    "db:reset-password": "npm run reset-password -w @armarios/api",
    "db:seed": "npm run seed -w @armarios/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@fastify/static": "^10.1.4",
    "uuid": "^11.1.1"
  },
  "version": "1.1.0"
}
