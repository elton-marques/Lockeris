# Exemplo para config/.env.portable no pacote portátil (não copie dados reais para o repositório).
PORT=3001
PGPORT=15432
PGDATABASE=lockeris
PGUSER=postgres
PGPASSWORD=sua_senha_local_aqui
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=sua_senha_temporaria_aqui

# Identidade impressa no Termo de Responsabilidade (build do web).
VITE_COMPANY_NAME=Ferreira Costa
# Opcional: coloque o arquivo em apps/web/public e informe o caminho (ex.: /logo-custom.png).
# VITE_COMPANY_LOGO_URL=
